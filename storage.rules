rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /conversations/{conversationId}/{userId}/{fileName} {
      function isConversationMember() {
        return request.auth != null
          && request.auth.uid == userId
          && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.members.hasAny([request.auth.uid]);
      }
      allow read: if request.auth != null
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.members.hasAny([request.auth.uid]);
      allow write: if isConversationMember()
        && request.resource != null
        && request.resource.size > 0
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 20 * 1024 * 1024)
        );
    }
  }
}