rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de perfil: solo el propietario puede subir o reemplazar.
    // Usuarios autenticados pueden ver fotos de perfil del directorio.
    match /users/{userId}/profile/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Los archivos del antiguo chat global quedan cerrados.
    match /messages/{allPaths=**} {
      allow read, write: if false;
    }

    // Cualquier otra ruta queda denegada por defecto.
  }
}