{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "cleanUrls": false
  },
  "functions": {
    "source": "functions",
    "codebase": "default"
  }
}
