rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
      allow delete: if false;
    }
    match /contactRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['senderId','recipientId','senderEmail','recipientEmail','status','createdAt']);
      allow read: if signedIn()
        && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.status in ['accepted','rejected'];
      allow delete: if false;
    }
    match /contacts/{pairId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/contacts/$(pairId))
          || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.requestId is string
        && existsAfter(/databases/$(database)/documents/contactRequests/$(request.resource.data.requestId))
        && getAfter(/databases/$(database)/documents/contactRequests/$(request.resource.data.requestId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/contactRequests/$(request.resource.data.requestId)).data.senderId in request.resource.data.members
        && getAfter(/databases/$(database)/documents/contactRequests/$(request.resource.data.requestId)).data.recipientId in request.resource.data.members;
      allow update, delete: if false;
    }
    match /conversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && existsAfter(/databases/$(database)/documents/contacts/$(conversationId))
        && request.resource.data.members == getAfter(/databases/$(database)/documents/contacts/$(conversationId)).data.members;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        allow create: if isMember(conversationId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.type in ['text','image','audio']
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.type in ['image','audio']
              && request.resource.data.storagePath is string
              && request.resource.data.storagePath.matches('conversations/' + conversationId + '/' + request.auth.uid + '/.*')
              && request.resource.data.mimeType is string
              && request.resource.data.size is int
              && request.resource.data.size > 0
              && request.resource.data.size <= (request.resource.data.type == 'image' ? 10485760 : 20971520)
              && request.resource.data.mediaUrl is string)
          );
        allow update, delete: if false;
      }
      match /calls/{callId} {
        function callMember() {
          return isMember(conversationId)
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
        }
        allow read: if callMember();
        allow create: if callMember()
          && request.resource.data.conversationId == conversationId
          && request.resource.data.callerId == request.auth.uid
          && request.resource.data.calleeId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.calleeId != request.auth.uid
          && request.resource.data.mode in ['audio','video']
          && request.resource.data.offer is map
          && request.resource.data.status == 'ringing'
          && request.resource.data.keys().hasOnly(['conversationId','callerId','calleeId','callerEmail','mode','status','offer','createdAt']);
        allow update: if callMember()
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.callerId == resource.data.callerId
          && request.resource.data.calleeId == resource.data.calleeId
          && request.resource.data.keys().hasOnly(['conversationId','callerId','calleeId','callerEmail','mode','status','offer','answer','createdAt','acceptedAt','endedAt'])
          && (
            (request.auth.uid == resource.data.calleeId && request.resource.data.status in ['accepted','rejected','ended','missed'])
            || (request.auth.uid == resource.data.callerId && request.resource.data.status == 'ended')
          );
        allow delete: if false;
        match /candidates/{candidateId} {
          allow read: if callMember();
          allow create: if callMember()
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.candidate is map;
          allow update, delete: if false;
        }
      }
    }
  }
}