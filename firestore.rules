rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.members is list
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members;
    }

    function callParticipantById(callId) {
      return signedIn()
        && exists(/databases/$(database)/documents/calls/$(callId))
        && (
          get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
          || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid
        );
    }

    match /users/{userId} {
      allow read: if signedIn();

      // Acepta cuentas nuevas verificadas por teléfono y conserva las cuentas antiguas por correo.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'phoneNumber', 'email', 'displayName', 'updatedAt', 'photoPath', 'photoUpdatedAt'
        ])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && (
          (request.resource.data.keys().hasAny(['phoneNumber'])
            && request.resource.data.phoneNumber is string
            && request.resource.data.phoneNumber == request.auth.token.phone_number)
          ||
          (request.resource.data.keys().hasAny(['email'])
            && request.resource.data.email is string
            && request.resource.data.email == request.auth.token.email)
        )
        && (!('photoPath' in request.resource.data) || request.resource.data.photoPath is string)
        && (!('photoUpdatedAt' in request.resource.data) || request.resource.data.photoUpdatedAt is timestamp);

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid', 'phoneNumber', 'email', 'displayName', 'updatedAt', 'photoPath', 'photoUpdatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && (
          (request.resource.data.keys().hasAny(['phoneNumber'])
            && request.resource.data.phoneNumber is string
            && request.resource.data.phoneNumber == request.auth.token.phone_number)
          ||
          (request.resource.data.keys().hasAny(['email'])
            && request.resource.data.email is string
            && request.resource.data.email == request.auth.token.email)
        )
        && (!('photoPath' in request.resource.data) || request.resource.data.photoPath is string)
        && (!('photoUpdatedAt' in request.resource.data) || request.resource.data.photoUpdatedAt is timestamp);

      allow delete: if false;
    }

    match /connectionRequests/{requestId} {
      allow read: if signedIn() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['senderId','recipientId','participants','senderName','status','createdAt'])
        && request.resource.data.keys().hasAll(['senderId','recipientId','participants','status','createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.recipientId in request.resource.data.participants
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && requestId == request.auth.uid + '__' + request.resource.data.recipientId;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','rejected']
        && request.resource.data.respondedAt == request.time;
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get: if signedIn()
        && (!exists(/databases/$(database)/documents/conversations/$(conversationId))
          || isConversationMember(conversationId));
      allow list: if isConversationMember(conversationId);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt'])
        && request.resource.data.keys().hasAll(['members', 'createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.createdAt == request.time
        && (
          (exists(/databases/$(database)/documents/connectionRequests/$(request.resource.data.members[0] + '__' + request.resource.data.members[1]))
            && get(/databases/$(database)/documents/connectionRequests/$(request.resource.data.members[0] + '__' + request.resource.data.members[1])).data.status == 'accepted')
          ||
          (exists(/databases/$(database)/documents/connectionRequests/$(request.resource.data.members[1] + '__' + request.resource.data.members[0]))
            && get(/databases/$(database)/documents/connectionRequests/$(request.resource.data.members[1] + '__' + request.resource.data.members[0])).data.status == 'accepted')
        );
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly([
            'type', 'text', 'storagePath', 'conversationId', 'mimeType', 'fileName',
            'size', 'duration', 'email', 'phoneNumber', 'uid', 'createdAt'
          ])
          && request.resource.data.keys().hasAll(['type', 'uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && (
            (request.resource.data.keys().hasAny(['phoneNumber'])
              && request.resource.data.phoneNumber is string
              && request.resource.data.phoneNumber == request.auth.token.phone_number)
            ||
            (request.resource.data.keys().hasAny(['email'])
              && request.resource.data.email is string
              && request.resource.data.email == request.auth.token.email)
          )
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.keys().hasAll(['text'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            ((request.resource.data.type == 'image' || request.resource.data.type == 'audio')
              && request.resource.data.keys().hasAll(['storagePath', 'conversationId', 'mimeType', 'size'])
              && request.resource.data.conversationId == conversationId
              && request.resource.data.storagePath is string
              && request.resource.data.storagePath.matches('dm/' + conversationId + '/[^/]+/.*')
              && request.resource.data.mimeType is string
              && request.resource.data.size is int
              && request.resource.data.size > 0
              && (
                (request.resource.data.type == 'image'
                  && request.resource.data.mimeType.matches('image/.*')
                  && request.resource.data.size <= 10485760)
                ||
                (request.resource.data.type == 'audio'
                  && request.resource.data.mimeType.matches('audio/.*')
                  && request.resource.data.size <= 20971520)
              ))
          );
        allow update, delete: if false;
      }
    }

    match /calls/{callId} {
      function isCallParticipant() {
        return signedIn()
          && (
            resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid
          );
      }

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'callerId', 'calleeId', 'conversationId', 'kind', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'callerId', 'calleeId', 'conversationId', 'kind', 'status', 'createdAt'
        ])
        && request.resource.data.callerId == request.auth.uid
        && request.resource.data.calleeId is string
        && request.resource.data.calleeId != request.auth.uid
        && request.resource.data.conversationId is string
        && isConversationMember(request.resource.data.conversationId)
        && get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.members.hasAny([request.resource.data.calleeId])
        && request.resource.data.kind in ['audio', 'video']
        && request.resource.data.status == 'preparing'
        && request.resource.data.createdAt == request.time;

      // El destinatario escucha una consulta filtrada por calleeId.
      // El emisor accede a su llamada mediante la referencia directa al documento.
      allow get: if isCallParticipant();
      allow list: if signedIn() && resource.data.calleeId == request.auth.uid;

      allow update: if isCallParticipant()
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'offer', 'answer', 'status', 'endedAt'
        ])
        && request.resource.data.status in ['preparing', 'ringing', 'accepted', 'rejected', 'ended'];
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read, create: if callParticipantById(callId);
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read, create: if callParticipantById(callId);
        allow update, delete: if false;
      }
    }
  }
}