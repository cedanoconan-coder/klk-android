rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConversationMember(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.members.hasAny([request.auth.uid]);
    }

    function acceptedRequest(requestId, uid, otherUid) {
      let req = getAfter(/databases/$(database)/documents/contactRequests/$(requestId)).data;
      return req.status == 'accepted'
        && ((req.fromUid == uid && req.toUid == otherUid)
          || (req.fromUid == otherUid && req.toUid == uid));
    }

    match /users/{uid} {
      // El directorio solo está disponible para usuarios autenticados.
      // No se deben guardar aquí contraseñas, tokens ni datos sensibles.
      allow get, list: if signedIn();
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 40;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        && (!request.resource.data.keys().hasAny(['displayName']) || request.resource.data.displayName is string)
        && (!request.resource.data.keys().hasAny(['photoURL']) || request.resource.data.photoURL is string);
      allow delete: if false;

      match /contacts/{otherUid} {
        allow get, list: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.otherUid == otherUid
          && request.resource.data.requestId is string
          && acceptedRequest(request.resource.data.requestId, uid, otherUid);
        allow update, delete: if false;
      }
    }

    match /contactRequests/{requestId} {
      allow get, list: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.auth.uid + '_' + request.resource.data.toUid
        && request.resource.data.status == 'pending'
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/contacts/$(request.resource.data.toUid));
      allow update: if signedIn()
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow get, list: if signedIn()
        && resource.data.members is list
        && resource.data.members.hasAny([request.auth.uid]);

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'createdBy'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAny([request.auth.uid])
        && request.resource.data.createdBy == request.auth.uid
        && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/contacts/$(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0]))
        && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0])/contacts/$(request.auth.uid));

      allow update, delete: if false;

      match /messages/{messageId} {
        allow get, list: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /calls/{callId} {
        allow get, list: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly(['callerId', 'callerName', 'calleeId', 'conversationId', 'type', 'status', 'offer', 'createdAt'])
          && request.resource.data.callerId == request.auth.uid
          && request.resource.data.calleeId is string
          && request.resource.data.calleeId != request.auth.uid
          && request.resource.data.conversationId == conversationId
          && request.resource.data.type in ['audio', 'video']
          && request.resource.data.status == 'ringing';
        allow update: if isConversationMember(conversationId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer', 'status'])
          && (request.auth.uid == resource.data.calleeId || request.auth.uid == resource.data.callerId)
          && request.resource.data.status in ['ringing', 'active', 'ended'];
        allow delete: if false;

        match /callerCandidates/{candidateId} {
          allow get, list: if isConversationMember(conversationId);
          allow create: if isConversationMember(conversationId)
            && get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data.callerId == request.auth.uid;
          allow update, delete: if false;
        }
        match /calleeCandidates/{candidateId} {
          allow get, list: if isConversationMember(conversationId);
          allow create: if isConversationMember(conversationId)
            && get(/databases/$(database)/documents/conversations/$(conversationId)/calls/$(callId)).data.calleeId == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }

    // Consulta collectionGroup usada para detectar llamadas entrantes.
    match /{path=**}/calls/{callId} {
      allow list: if signedIn()
        && resource.data.calleeId == request.auth.uid
        && isConversationMember(resource.data.conversationId);
    }
  }
}