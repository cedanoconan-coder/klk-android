rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function validMessageExpiry(conversationId) {
      let settingsPath = /databases/$(database)/documents/conversations/$(conversationId)/settings/disappearingMessages;
      return (!exists(settingsPath) && !request.resource.data.keys().hasAny(['expiresAt']))
        || (exists(settingsPath)
          && get(settingsPath).data.durationHours == 0
          && !request.resource.data.keys().hasAny(['expiresAt']))
        || (exists(settingsPath)
          && get(settingsPath).data.durationHours == 24
          && request.resource.data.keys().hasAny(['expiresAt'])
          && request.resource.data.expiresAt >= request.time + duration.value(24, 'h') - duration.value(2, 'm')
          && request.resource.data.expiresAt <= request.time + duration.value(24, 'h') + duration.value(2, 'm'))
        || (exists(settingsPath)
          && get(settingsPath).data.durationHours == 168
          && request.resource.data.keys().hasAny(['expiresAt'])
          && request.resource.data.expiresAt >= request.time + duration.value(168, 'h') - duration.value(2, 'm')
          && request.resource.data.expiresAt <= request.time + duration.value(168, 'h') + duration.value(2, 'm'))
        || (exists(settingsPath)
          && get(settingsPath).data.durationHours == 2160
          && request.resource.data.keys().hasAny(['expiresAt'])
          && request.resource.data.expiresAt >= request.time + duration.value(2160, 'h') - duration.value(2, 'm')
          && request.resource.data.expiresAt <= request.time + duration.value(2160, 'h') + duration.value(2, 'm'));
    }
    function canStartConversation(members) {
      let otherUid = members[0] == request.auth.uid ? members[1] : members[0];
      return exists(/databases/$(database)/documents/publicProfiles/$(otherUid))
        && get(/databases/$(database)/documents/publicProfiles/$(otherUid)).data.directoryVisible == true
        && !exists(/databases/$(database)/documents/userBlocks/$(request.auth.uid)/blocked/$(otherUid))
        && !exists(/databases/$(database)/documents/userBlocks/$(otherUid)/blocked/$(request.auth.uid));
    }
    // Para listar el índice de chats solo se comprueba pertenencia. Esta consulta
    // devuelve metadatos mínimos; los bloqueos se aplican al abrir el chat y leer mensajes.
    function isConversationParticipantData(members) {
      // La consulta array-contains demuestra pertenencia; no añadimos condiciones
      // (como tamaño exacto) que Firestore no puede inferir del filtro de consulta.
      return signedIn() && request.auth.uid in members;
    }
    function isConversationMemberData(members) {
      return isConversationParticipantData(members)
        && !exists(/databases/$(database)/documents/userBlocks/$(request.auth.uid)/blocked/$(members[0] == request.auth.uid ? members[1] : members[0]))
        && !exists(/databases/$(database)/documents/userBlocks/$(members[0] == request.auth.uid ? members[1] : members[0])/blocked/$(request.auth.uid));
    }
    function isConversationMember(conversationId) {
      return exists(/databases/$(database)/documents/conversations/$(conversationId))
        && isConversationMemberData(get(/databases/$(database)/documents/conversations/$(conversationId)).data.members);
    }
    function validUserProfile(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        // El correo es metadato privado editable por el propietario; la identidad
        // y la autorización se verifican por UID, no por un claim de correo que puede faltar o quedar obsoleto.
        && (!request.resource.data.keys().hasAny(['email'])
          || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && (!request.resource.data.keys().hasAny(['photoPath'])
          || (request.resource.data.photoPath is string
            && request.resource.data.photoPath.matches('avatars/' + request.auth.uid + '/[^/]+')))
        && (!request.resource.data.keys().hasAny(['coverPath']) || (request.resource.data.coverPath is string && request.resource.data.coverPath.size() <= 500))
        && (!request.resource.data.keys().hasAny(['about']) || (request.resource.data.about is string && request.resource.data.about.size() <= 139))
        && (!request.resource.data.keys().hasAny(['mood']) || (request.resource.data.mood is string && request.resource.data.mood.size() <= 40))
        && (!request.resource.data.keys().hasAny(['directoryVisible']) || request.resource.data.directoryVisible is bool);
    }
    function validInvitationForProfile() {
      return request.resource.data.inviteCode is string
        && existsAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteCode))
        && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.inviteCode)).data.redeemedBy == request.auth.uid;
    }

    match /invitations/{code} {
      // Solo se permite consultar un código concreto; no se puede listar invitaciones.
      allow get: if signedIn() && resource.data.redeemedBy == null && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['createdBy','createdAt','expiresAt','redeemedBy','redeemedAt'])
        && request.resource.data.keys().hasAll(['createdBy','createdAt','expiresAt','redeemedBy','redeemedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(8, 'd')
        && request.resource.data.redeemedBy == null
        && request.resource.data.redeemedAt == null;
      allow update: if signedIn()
        && resource.data.redeemedBy == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['redeemedBy','redeemedAt'])
        && request.resource.data.redeemedBy == request.auth.uid
        && request.resource.data.redeemedAt == request.time;
      allow delete: if false;
    }

    match /users/{userId} {
      // Datos privados: solo el propietario puede leer su propio documento.
      allow read: if signedIn() && request.auth.uid == userId;

      // New profiles may contain only fields managed by klk.
      allow create: if validUserProfile(userId)
        && validInvitationForProfile()
        && request.resource.data.keys().hasOnly(['uid','email','displayName','photoPath','coverPath','about','mood','directoryVisible','updatedAt','inviteCode','invitedBy'])
        && request.resource.data.keys().hasAll(['uid','email','displayName','updatedAt','inviteCode','invitedBy'])
        && request.resource.data.updatedAt == request.time;

      // On legacy profiles, validate only changed fields. This lets users add
      // photoPath without failing because older documents contain old fields.
      allow update: if validUserProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uid','email','displayName','photoPath','coverPath','about','mood','directoryVisible','updatedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt'])
          || request.resource.data.updatedAt == request.time);

      allow delete: if false;
    }
    match /publicProfiles/{userId} {
      function validPublicProfile() {
        return signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasOnly(['uid','displayName','about','mood','photoPath','coverPath','directoryVisible','updatedAt'])
          && request.resource.data.keys().hasAll(['uid','displayName','directoryVisible','updatedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.directoryVisible is bool
          && request.resource.data.updatedAt == request.time
          && (!request.resource.data.keys().hasAny(['about']) || (request.resource.data.about is string && request.resource.data.about.size() <= 139))
          && (!request.resource.data.keys().hasAny(['mood']) || (request.resource.data.mood is string && request.resource.data.mood.size() <= 40))
          && (!request.resource.data.keys().hasAny(['photoPath']) || (request.resource.data.photoPath is string && request.resource.data.photoPath.size() <= 500))
          && (!request.resource.data.keys().hasAny(['coverPath']) || (request.resource.data.coverPath is string && request.resource.data.coverPath.size() <= 500));
      }
      function validPublicProfileUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return signedIn()
          && request.auth.uid == userId
          && request.resource.data.uid == userId
          && changed.hasOnly(['uid','displayName','about','mood','photoPath','coverPath','directoryVisible','updatedAt'])
          && (!changed.hasAny(['displayName']) || (request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 100))
          && (!changed.hasAny(['directoryVisible']) || request.resource.data.directoryVisible is bool)
          && (!changed.hasAny(['about']) || (request.resource.data.about is string && request.resource.data.about.size() <= 139))
          && (!changed.hasAny(['mood']) || (request.resource.data.mood is string && request.resource.data.mood.size() <= 40))
          && (!changed.hasAny(['photoPath']) || (request.resource.data.photoPath is string && request.resource.data.photoPath.size() <= 500))
          && (!changed.hasAny(['coverPath']) || (request.resource.data.coverPath is string && request.resource.data.coverPath.size() <= 500))
          && (!changed.hasAny(['updatedAt']) || request.resource.data.updatedAt == request.time);
      }
      allow list: if signedIn() && resource.data.directoryVisible == true;
      allow get: if signedIn() && (request.auth.uid == userId || resource.data.directoryVisible == true);
      allow create: if validPublicProfile();
      // En documentos antiguos, validar solo los campos modificados sin bloquear
      // la actualización por campos heredados que esta versión ya no utiliza.
      allow update: if validPublicProfileUpdate();
      allow delete: if false;
    }

    match /users/{userId}/pushTokens/{tokenId} {
      // Cada miembro solo puede registrar o actualizar sus propios dispositivos.
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token','platform','userAgent','updatedAt'])
        && request.resource.data.keys().hasAll(['token','platform','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() > 50
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'web'
        && (!request.resource.data.keys().hasAny(['userAgent'])
          || (request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 300));
      allow read, delete: if false;
    }


    // Contactos QR: privacidad por defecto = aprobación.
    match /contactPrivacy/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['mode','updatedAt'])
        && request.resource.data.mode in ['approval','direct']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /qrContactRequests/{requestId} {
      function validRequest() {
        return signedIn()
          && request.resource.data.keys().hasOnly(['from','to','status','createdAt','updatedAt'])
          && request.resource.data.from is string
          && request.resource.data.to is string
          && request.resource.data.from != request.resource.data.to
          && requestId == request.resource.data.from + '_' + request.resource.data.to;
      }
      allow get, list: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if validRequest()
        && request.auth.uid == request.resource.data.from
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && !exists(/databases/$(database)/documents/userBlocks/$(request.resource.data.to)/blocked/$(request.auth.uid))
        && !exists(/databases/$(database)/documents/userBlocks/$(request.auth.uid)/blocked/$(request.resource.data.to));
      allow update: if validRequest()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /qrContacts/{uid}/members/{otherUid} {
      function allowedLink() {
        return (exists(/databases/$(database)/documents/contactPrivacy/$(otherUid))
          && get(/databases/$(database)/documents/contactPrivacy/$(otherUid)).data.mode == 'direct')
          || (exists(/databases/$(database)/documents/qrContactRequests/$(uid + '_' + otherUid))
          && get(/databases/$(database)/documents/qrContactRequests/$(uid + '_' + otherUid)).data.status == 'approved')
          || (exists(/databases/$(database)/documents/qrContactRequests/$(otherUid + '_' + uid))
          && get(/databases/$(database)/documents/qrContactRequests/$(otherUid + '_' + uid)).data.status == 'approved');
      }
      allow get, list: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && uid != otherUid
        && request.resource.data.keys().hasOnly(['uid','addedAt'])
        && request.resource.data.uid == otherUid
        && request.resource.data.addedAt == request.time
        && !exists(/databases/$(database)/documents/userBlocks/$(uid)/blocked/$(otherUid))
        && !exists(/databases/$(database)/documents/userBlocks/$(otherUid)/blocked/$(uid))
        && allowedLink();
      allow delete: if signedIn() && request.auth.uid == uid;
      allow update: if false;
    }

    // KLK Historias: solo contactos QR autorizados, nunca el directorio público.
    match /klkStories/{authorUid}/posts/{storyId} {
      function isContact() {
        return signedIn() && (
          exists(/databases/$(database)/documents/qrContacts/$(authorUid)/members/$(request.auth.uid))
          || exists(/databases/$(database)/documents/qrContacts/$(request.auth.uid)/members/$(authorUid))
        ) && !exists(/databases/$(database)/documents/userBlocks/$(authorUid)/blocked/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/userBlocks/$(request.auth.uid)/blocked/$(authorUid));
      }
      function canView() { return signedIn() && (request.auth.uid == authorUid || isContact()); }
      allow get, list: if canView();
      allow create: if signedIn() && request.auth.uid == authorUid
        && request.resource.data.keys().hasOnly(['authorUid','title','text','createdAt'])
        && request.resource.data.keys().hasAll(['authorUid','title','text','createdAt'])
        && request.resource.data.authorUid == authorUid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 3000
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && request.auth.uid == authorUid;
      allow update: if false;
      match /reactions/{reactorUid} {
        allow get, list: if signedIn() && (request.auth.uid == authorUid || request.auth.uid == reactorUid);
        allow create, update: if signedIn() && request.auth.uid == reactorUid
          && reactorUid != authorUid
          && exists(/databases/$(database)/documents/klkStories/$(authorUid)/posts/$(storyId))
          && (exists(/databases/$(database)/documents/qrContacts/$(authorUid)/members/$(reactorUid))
              || exists(/databases/$(database)/documents/qrContacts/$(reactorUid)/members/$(authorUid)))
          && !exists(/databases/$(database)/documents/userBlocks/$(authorUid)/blocked/$(reactorUid))
          && !exists(/databases/$(database)/documents/userBlocks/$(reactorUid)/blocked/$(authorUid))
          && request.resource.data.keys().hasOnly(['emoji','updatedAt'])
          && request.resource.data.emoji in ['❤️','😂','👏','😮','💜']
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == reactorUid;
      }
    }

    // Solicitudes de amistad retiradas: el chat se inicia directamente desde perfiles visibles.
    match /contactRequests/{requestId} {
      allow read, write: if false;
    }
    // Lista de bloqueos privada: solo el propietario puede consultar y administrar sus bloqueos.
    match /userBlocks/{userId}/blocked/{blockedUid} {
      allow get, list: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && blockedUid != userId
        && request.resource.data.keys().hasOnly(['blockedUid','createdAt'])
        && request.resource.data.keys().hasAll(['blockedUid','createdAt'])
        && request.resource.data.blockedUid == blockedUid
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && request.auth.uid == userId;
      allow update: if false;
    }

    // Grupos: solamente sus integrantes pueden leer y enviar mensajes.
    match /klkGroups/{groupId} {
      function groupMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }
      allow get, list: if groupMember();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','members','admin','createdAt'])
        && request.resource.data.keys().hasAll(['name','members','admin','createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 50
        && request.resource.data.members.toSet().size() == request.resource.data.members.size()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.admin == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /messages/{messageId} {
        function member() {
          return signedIn()
            && exists(/databases/$(database)/documents/klkGroups/$(groupId))
            && request.auth.uid in get(/databases/$(database)/documents/klkGroups/$(groupId)).data.members;
        }
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasOnly(['uid','text','createdAt'])
          && request.resource.data.keys().hasAll(['uid','text','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /conversations/{conversationId} {
      // Permite comprobar si todavía no existe una conversación, sin revelar documentos existentes.
      allow get: if isConversationMember(conversationId)
        || (signedIn() && !exists(/databases/$(database)/documents/conversations/$(conversationId)));
      // La consulta debe incluir array-contains con el UID autenticado.
      // Así Firestore puede demostrar que cada documento devuelto pertenece al usuario.
      allow list: if isConversationParticipantData(resource.data.members);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members','createdAt'])
        && request.resource.data.keys().hasAll(['members','createdAt'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.createdAt == request.time
        && request.resource.data.members[0] < request.resource.data.members[1]
        && conversationId == request.resource.data.members[0] + '__' + request.resource.data.members[1]
        && canStartConversation(request.resource.data.members);
      allow update, delete: if false;
      // Consentimiento independiente de los chats. Ninguna invitación da acceso
      // a recuerdos hasta que el destinatario acepte explícitamente.
      match /momentSharing/{consentId} {
        allow get: if consentId == 'consent' && isConversationMember(conversationId);
        allow list: if false;
        allow create: if consentId == 'consent'
          && isConversationMember(conversationId)
          && request.resource.data.keys().hasOnly(['inviterUid','inviteeUid','state','createdAt'])
          && request.resource.data.keys().hasAll(['inviterUid','inviteeUid','state','createdAt'])
          && request.resource.data.inviterUid == request.auth.uid
          && request.resource.data.inviteeUid is string
          && request.resource.data.inviteeUid != request.auth.uid
          && request.resource.data.inviteeUid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.members
          && request.resource.data.state == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if consentId == 'consent'
          && isConversationMember(conversationId)
          && resource.data.keys().hasAll(['inviterUid','inviteeUid','state','createdAt'])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','respondedAt'])
          && request.resource.data.respondedAt == request.time
          && ((resource.data.state == 'pending'
              && request.auth.uid == resource.data.inviteeUid
              && request.resource.data.state in ['accepted','rejected'])
            || (resource.data.state == 'accepted'
              && request.auth.uid in [resource.data.inviterUid, resource.data.inviteeUid]
              && request.resource.data.state == 'revoked'));
        allow delete: if false;
      }
      // KLK Momentos: recuerdos de una conversación existente.
      // Las cápsulas futuras requieren entrega segura del contenido al desbloquearse;
      // no se admiten aquí porque los participantes podrían leerlo antes.
      // Solo los dos participantes no bloqueados pueden acceder.
      match /moments/{momentId} {
        allow get, list: if isConversationMember(conversationId)
          && exists(/databases/$(database)/documents/conversations/$(conversationId)/momentSharing/consent)
          && get(/databases/$(database)/documents/conversations/$(conversationId)/momentSharing/consent).data.state == 'accepted';
        allow create: if isConversationMember(conversationId)
          && exists(/databases/$(database)/documents/conversations/$(conversationId)/momentSharing/consent)
          && get(/databases/$(database)/documents/conversations/$(conversationId)/momentSharing/consent).data.state == 'accepted'
          && request.resource.data.keys().hasOnly(['title','message','createdBy','createdAt','unlockAt','kind'])
          && request.resource.data.keys().hasAll(['title','message','createdBy','createdAt','kind'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 90
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 2000
          && request.resource.data.kind == 'memory'
          && !request.resource.data.keys().hasAny(['unlockAt']);
        // No edición ni borrado hasta diseñar reglas de consentimiento.
        allow update, delete: if false;
      }
      match /activity/{userId} {
        allow get: if isConversationMember(conversationId);
        allow list: if false;
        allow create, update: if isConversationMember(conversationId)
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['uid','kind','updatedAt'])
          && request.resource.data.keys().hasAll(['uid','kind','updatedAt'])
          && request.resource.data.uid == userId
          && request.resource.data.kind in ['typing','recording','idle','online','offline']
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
      match /settings/{settingId} {
        // Configuración compartida del chat: solo sus dos participantes pueden verla o cambiarla.
        allow read: if isConversationMember(conversationId);
        allow create, update: if isConversationMember(conversationId)
          && settingId == 'disappearingMessages'
          && request.resource.data.keys().hasOnly(['durationHours','updatedAt','updatedBy'])
          && request.resource.data.keys().hasAll(['durationHours','updatedAt','updatedBy'])
          && request.resource.data.durationHours is int
          && request.resource.data.durationHours in [0, 24, 168, 2160]
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
      match /messages/{messageId} {
        allow read: if isConversationMember(conversationId);
        allow create: if isConversationMember(conversationId)
          && validMessageExpiry(conversationId)
          && request.resource.data.keys().hasOnly([
            'type','text','storagePath','conversationId','mimeType','fileName',
            'size','duration','latitude','longitude','email','uid','displayName','createdAt','expiresAt'
          ])
          && request.resource.data.keys().hasAll(['type','uid','createdAt'])
          && request.resource.data.uid == request.auth.uid
          && (!request.resource.data.keys().hasAny(['email'])
            || (request.resource.data.email is string && request.resource.data.email.size() <= 254))
          && (!request.resource.data.keys().hasAny(['displayName'])
            || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() > 0
              && request.resource.data.displayName.size() <= 100))
          && request.resource.data.createdAt == request.time
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.keys().hasAll(['text'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.type == 'sticker'
              && request.resource.data.keys().hasAll(['text'])
              && request.resource.data.text is string
              && (request.resource.data.text in ['❤️','😂','😍','🥰','😘','😭','😎','🥳','🔥','👍','👎','👏','🙏','💯','🤔','😴','🤗','🎉','💔','🤩','😡','🤝','👋','🙌']
                || request.resource.data.text in ['KLK:👍','KLK:😂','KLK:❤️','KLK:🎉','KLK:🙏','KLK:😎','KLK:01','KLK:02','KLK:03','KLK:04','KLK:05','KLK:06','KLK:07','KLK:08','KLK:09','KLK:10','KLK:11','KLK:12','KLK:13','KLK:14','KLK:15','KLK:16','KLK:17','KLK:18','KLK:19','KLK:20','KLK:21','KLK:22','KLK:23','KLK:24','KLK:25','KLK:26','KLK:27','KLK:28','KLK:29','KLK:30']))
            ||
            (request.resource.data.type == 'location'
              && request.resource.data.keys().hasAll(['latitude','longitude'])
              && request.resource.data.latitude is number
              && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
              && request.resource.data.longitude is number
              && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180)
            ||
            ((request.resource.data.type == 'image' || request.resource.data.type == 'audio' || request.resource.data.type == 'file')
              && request.resource.data.keys().hasAll(['storagePath','conversationId','mimeType','size'])
              && request.resource.data.conversationId == conversationId
              && request.resource.data.storagePath is string
              && request.resource.data.storagePath.matches('dm/' + conversationId + '/[^/]+/.*')
              && request.resource.data.mimeType is string
              && request.resource.data.size is int
              && request.resource.data.size > 0
              && ((request.resource.data.type == 'image' && request.resource.data.mimeType.matches('image/.*') && request.resource.data.size <= 10485760)
                || (request.resource.data.type == 'audio' && request.resource.data.mimeType.matches('audio/.*') && request.resource.data.size <= 20971520)
              || (request.resource.data.type == 'file' && request.resource.data.mimeType is string && request.resource.data.size <= 20971520)))
          );
        // El destinatario puede marcar como leídos los mensajes del otro miembro.
        allow update: if isConversationMember(conversationId)
          && (
            (resource.data.uid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
              && request.resource.data.readBy is list
              && request.resource.data.readBy.size() == 1
              && request.auth.uid in request.resource.data.readBy)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedFor'])
              && request.resource.data.deletedFor is list
              && request.resource.data.deletedFor.size() == resource.data.get('deletedFor', []).size() + 1
              && request.resource.data.deletedFor.hasAll(resource.data.get('deletedFor', []))
              && request.resource.data.deletedFor.hasAll([request.auth.uid]))
          );
        allow delete: if isConversationMember(conversationId) && resource.data.uid == request.auth.uid;
      }
    }

    match /statuses/{statusId} {
      // Los estados solo pueden ser consultados por el autor o un contacto QR autorizado.
      function canViewStatus(authorUid) {
        return signedIn() && (request.auth.uid == authorUid
          || ((
            exists(/databases/$(database)/documents/qrContacts/$(authorUid)/members/$(request.auth.uid))
            || exists(/databases/$(database)/documents/qrContacts/$(request.auth.uid)/members/$(authorUid))
          )
          && !exists(/databases/$(database)/documents/userBlocks/$(authorUid)/blocked/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/userBlocks/$(request.auth.uid)/blocked/$(authorUid))));
      }
      allow get, list: if canViewStatus(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','displayName','type','text','storagePath','mimeType','size','createdAt','expiresAt'])
        && request.resource.data.keys().hasAll(['uid','displayName','type','text','createdAt','expiresAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100
        && request.resource.data.type in ['text','image','video']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(23, 'h')
        && request.resource.data.expiresAt <= request.time + duration.value(25, 'h')
        && ((request.resource.data.type == 'text' && !request.resource.data.keys().hasAny(['storagePath','mimeType','size']))
          || (request.resource.data.type == 'image'
            && request.resource.data.keys().hasAll(['storagePath','mimeType','size'])
            && request.resource.data.storagePath is string
            && request.resource.data.storagePath.matches('statuses/' + request.auth.uid + '/[^/]+')
            && request.resource.data.mimeType.matches('image/.*')
            && request.resource.data.size is int
            && request.resource.data.size > 0
            && request.resource.data.size <= 10485760)
          || (request.resource.data.type == 'video'
            && request.resource.data.keys().hasAll(['storagePath','mimeType','size'])
            && request.resource.data.storagePath is string
            && request.resource.data.storagePath.matches('statuses/' + request.auth.uid + '/[^/]+')
            && request.resource.data.mimeType in ['video/mp4','video/webm','video/quicktime','video/3gpp']
            && request.resource.data.size is int
            && request.resource.data.size > 0
            && request.resource.data.size <= 52428800));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;

      match /views/{viewerUid} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.uid == request.auth.uid;
        allow create, update: if signedIn()
          && viewerUid == request.auth.uid
          && canViewStatus(get(/databases/$(database)/documents/statuses/$(statusId)).data.uid)
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.uid != request.auth.uid
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.expiresAt > request.time
          && request.resource.data.keys().hasOnly(['uid','displayName','viewedAt'])
          && request.resource.data.keys().hasAll(['uid','displayName','viewedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.viewedAt == request.time;
        allow delete: if false;
      }

      // Cada usuario puede registrar o quitar su propio me gusta en un estado.
      match /likes/{likerUid} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/statuses/$(statusId))
          && canViewStatus(get(/databases/$(database)/documents/statuses/$(statusId)).data.uid);
        allow create: if signedIn()
          && likerUid == request.auth.uid
          && exists(/databases/$(database)/documents/statuses/$(statusId))
          && canViewStatus(get(/databases/$(database)/documents/statuses/$(statusId)).data.uid)
          && get(/databases/$(database)/documents/statuses/$(statusId)).data.expiresAt > request.time
          && request.resource.data.keys().hasOnly(['uid','displayName','likedAt'])
          && request.resource.data.keys().hasAll(['uid','displayName','likedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() <= 100
          && request.resource.data.likedAt == request.time;
        allow delete: if signedIn() && likerUid == request.auth.uid;
        allow update: if false;
      }
    }

    match /calls/{callId} {
      function callParticipant() {
        return signedIn() && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
      }
      allow get: if callParticipant();
      allow list: if signedIn() && (resource.data.calleeUid == request.auth.uid || resource.data.callerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['callerUid','calleeUid','conversationId','mode','status','offer','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['callerUid','calleeUid','conversationId','mode','status','offer','createdAt','updatedAt'])
        && request.resource.data.callerUid == request.auth.uid
        && request.resource.data.calleeUid is string
        && request.resource.data.calleeUid != request.auth.uid
        && (request.resource.data.conversationId == request.resource.data.callerUid + '__' + request.resource.data.calleeUid
          || request.resource.data.conversationId == request.resource.data.calleeUid + '__' + request.resource.data.callerUid)
        && request.resource.data.mode in ['audio','video']
        && request.resource.data.status == 'ringing'
        && request.resource.data.offer is map
        && request.resource.data.offer.type == 'offer'
        && request.resource.data.offer.sdp is string
        && request.resource.data.offer.sdp.size() <= 200000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && isConversationMember(request.resource.data.conversationId);
      allow update: if callParticipant()
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.mode == resource.data.mode
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status == 'active'
            && request.resource.data.answer is map
            && request.resource.data.answer.type == 'answer'
            && request.resource.data.answer.sdp is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answer','status','connectedAt','updatedAt']))
          ||
          (request.auth.uid == resource.data.calleeUid
            && resource.data.status == 'ringing'
            && request.resource.data.status == 'rejected'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']))
          ||
          (request.resource.data.status == 'ended'
            && resource.data.status in ['ringing','active']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt','endedAt']))
        )
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /{candidateCollection}/{candidateId} {
        function parentCallParticipant() {
          let parentCall = get(/databases/$(database)/documents/calls/$(callId)).data;
          return signedIn() && (parentCall.callerUid == request.auth.uid || parentCall.calleeUid == request.auth.uid);
        }
        allow read: if parentCallParticipant();
        allow create: if parentCallParticipant()
          && candidateCollection in ['callerCandidates','calleeCandidates']
          && ((candidateCollection == 'callerCandidates' && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.callerUid)
            || (candidateCollection == 'calleeCandidates' && request.auth.uid == get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid))
          && request.resource.data.keys().hasOnly(['candidate','sdpMid','sdpMLineIndex','usernameFragment'])
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() <= 2048;
        allow update, delete: if false;
      }
    }

    // The legacy global /messages collection is intentionally inaccessible.
    match /messages/{messageId} {
      allow read, write: if false;
    }
  }
}